# ---------------------------------------------------------------------------
# SOC-Triage backend configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# The React frontend never reads this file: every secret stays server-side.
# ---------------------------------------------------------------------------

# Which provider the agent uses. One of: groq | gemini | codex | mock
#   groq   - GroqCloud free tier (primary)
#   gemini - Google Gemini free tier (secondary)
#   mock   - deterministic simulated model, no network, no key (demo / tests)
#   codex  - local Codex CLI signed in with ChatGPT; counts toward Codex usage
# Switching provider is a config change only; no code edits required.
AI_PROVIDER=mock

# --- GroqCloud (primary) ---------------------------------------------------
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=
# Default model. Must support tool calling. Verify with `python -m services.preflight`.
GROQ_MODEL=openai/gpt-oss-20b

# --- Google Gemini (secondary) --------------------------------------------
# Free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Codex CLI (ChatGPT sign-in) -------------------------------------------
# Install Codex CLI and run `codex login` on the same computer/account that runs
# the Python API. `default` uses the CLI's built-in model choice.
CODEX_MODEL=default

# --- Optional third provider (adapter not implemented) ---------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Agent behaviour (safe bounds) ---------------------------------------
# Maximum model turns in one investigation.
AI_MAX_STEPS=6
# Total wall-clock budget for a single investigation, seconds.
AI_REQUEST_TIMEOUT=45
# Upper bound on tool calls per investigation.
AI_MAX_TOOL_CALLS=12
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0

# --- Data / storage -------------------------------------------------------
# Paths are resolved relative to the repository root.
ALERTS_PATH=src/real-alerts.json
TIMELINES_PATH=src/real-timelines.json
AUDIT_LOG_PATH=data/audit/triage-audit.jsonl
TRIAGE_STATE_PATH=data/state/triage-results.json

# --- HTTP ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma separated. Only these browser origins may call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
